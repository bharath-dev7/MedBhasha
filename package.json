{
  "name": "medbhasha-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "MedBhasha - AI-assisted, offline-first, multilingual medication assistant with Translation Lock",
  "workspaces": [
    "backend",
    "patient-app"
  ],
  "scripts": {
    "start:backend": "npm --prefix backend run dev",
    "start:patient": "npm --prefix patient-app run dev",
    "start:portal": "npm --prefix patient-app run dev",
    "dev": "npm --prefix patient-app run dev",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  }
}
